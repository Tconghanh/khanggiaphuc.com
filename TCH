     $paths = @("HKCU:\Software\Microsoft\Windows\CurrentVersion\Run", "HKLM:\Software\Microsoft\Windows\CurrentVersion\Run")
     foreach ($path in $paths) {
    if (Test-Path $path) {
        (Get-Item $path -ErrorAction SilentlyContinue).Property | ForEach-Object {
            $n = $_
            if ($n -notmatch "EVKey|UniKey|OneDrive|SecurityHealth") {
                Remove-ItemProperty -Path $path -Name $n -Force -ErrorAction SilentlyContinue
