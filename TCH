$btnExSw.Add_Click({
    $sel = $listSw.CheckedItems; if($sel.Count -eq 0){return}
    $c = 0; $t = $sel.Count
    foreach($item in $sel){
        $c++; Add-Log "Installing: $item"; Update-P $c $t
        $id = $global:SwMap[$item]
        if($id -eq "VinaCAD.Custom"){ 
            $url = "https://vinacad.s3.ap-northeast-1.amazonaws.com/products/all/VinaCAD_2026.6.3.exe"
            (New-Object Net.WebClient).DownloadFile($url, "$env:TEMP\VinaCAD.exe"); Start-Process "$env:TEMP\VinaCAD.exe" -Wait
        } elseif($id -eq "Optimizer.GitHub"){
            $url = "https://github.com/hellzerg/optimizer/releases/latest/download/Optimizer.exe"
            (New-Object Net.WebClient).DownloadFile($url, "$env:TEMP\Optimizer.exe"); Start-Process "$env:TEMP\Optimizer.exe"
        } else { Start-Process winget -ArgumentList "install --id $id --silent --accept-package-agreements" -Wait }
    }
    Add-Log "Installation finished."
})

# --- UNINSTALL LOGIC (FIXED UNIKEY) ---
$btnExUn.Add_Click({
    $sel = $listUn.CheckedItems; if($sel.Count -eq 0){return}
    if([Windows.Forms.MessageBox]::Show("Uninstall $($sel.Count) items?","Confirm","YesNo") -eq "Yes"){
        $c = 0; $t = $sel.Count
        foreach($item in $sel){
            $c++; Add-Log "Uninstalling: $item"; Update-P $c $t
            # Kill process if UniKey
            if($item -like "*UniKey*"){ Stop-Process -Name "UniKey" -Force -ErrorAction SilentlyContinue }
            $d = $global:UnTable[$item]
            if($d.Un -match '{[A-Z0-9-]+}'){ Start-Process "msiexec.exe" -ArgumentList "/x $($matches[0]) /qn" -Wait }
            else { 
                $ex = if($d.Un.StartsWith('"')){($d.Un -split '"')[1]}else{($d.Un -split ' ')[0]}
                # Add silent flags for common installers
                Start-Process $ex -ArgumentList "/S /silent /VERYSILENT /SUPPRESSMSGBOXES" -Wait 
            }
        }
        Scan-Apps; Add-Log "Uninstallation finished."
    }
})

