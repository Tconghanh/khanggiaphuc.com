$btnExUn.Add_Click({
    $sel = $listUn.CheckedItems; if($sel.Count -eq 0){return}
    if([System.Windows.Forms.MessageBox]::Show("Uninstall $($sel.Count) items?","Confirm","YesNo","Question") -eq "Yes"){
        $c = 0; $t = $sel.Count
        foreach($item in $sel){
            $c++; Add-Log "Uninstalling: $item"; Update-P $c $t
            try {
                if($item -like "*UniKey*"){ Stop-Process -Name "UniKey" -Force -ErrorAction SilentlyContinue }
                $d = $global:UnTable[$item]
                if($d.Type -eq "Win32"){
                    $unString = $d.Un
                    if($unString -match '{[A-Z0-9-]+}'){ Start-Process "msiexec.exe" -ArgumentList "/x $($matches[0]) /qn /norestart" -Wait } 
                    else { 
                        if ($unString.StartsWith('"')) { $split = $unString -split '"'; $ex = $split[1]; $args = $split[2..$split.Length] -join '"' } 
                        else { $split = $unString -split ' '; $ex = $split[0]; $args = $split[1..$split.Length] -join ' ' }
                        $args += " /S /silent /VERYSILENT /qn /quiet"; Start-Process $ex -ArgumentList $args -Wait -ErrorAction SilentlyContinue
                    }
                } else { Get-AppxPackage $d.Name -AllUsers | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue }
            } catch { Add-Log "Failed to uninstall: $item" }
        }
        Scan-Apps; Update-P 100 100; Add-Log "Uninstallation finished."
    }
})

