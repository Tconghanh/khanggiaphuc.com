# Tweaks Logic
$btnExecTw.Add_Click({
    $sel = $listTw.CheckedItems; $total = $sel.Count; $count = 0; if($total -eq 0){return}
    foreach ($t in $sel) {
        $count++; Update-UI $count $total "Applying: $t"
        if ($t -like "*Activity History*") { reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\System" /v "PublishUserActivities" /t REG_DWORD /d 0 /f }
        if ($t -like "*Telemetry*") { reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection" /v "AllowTelemetry" /t REG_DWORD /d 0 /f; Set-Service DiagTrack -StartupType Disabled }
        if ($t -like "*End Task*") { reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v "TaskbarEndTask" /t REG_DWORD /d 1 /f }
        if ($t -like "*Temporary Files*") { @("$env:TEMP\*", "C:\Windows\Temp\*") | ForEach-Object { Remove-Item $_ -Recurse -Force } }
        if ($t -like "*Disk Cleanup*") { Dism /Online /Cleanup-Image /StartComponentCleanup /ResetBase }
        if ($t -like "*Unwanted Apps*") { 
            $junk = @(); foreach($i in $listApps.Items){ foreach($j in $JunkKeywords){if($i -like "*$j*"){$junk+=$i;break}}}
            $totalUn = $junk.Count; $cUn = 0
            foreach($app in $junk){ $cUn++; Update-UI $cUn $totalUn "Removing Bloat: $app"; $d=$global:AppData[$app]; if($d.Type -eq "Appx"){Get-AppxPackage $d.Name -AllUsers | Remove-AppxPackage} }
        }
    }
    Scan-Apps; [Windows.Forms.MessageBox]::Show("Tweaks Complete!")
})

# Uninstall Logic
$btnExecApp.Add_Click({ 
    $sel = @(); foreach($i in $listApps.CheckedItems){$sel+=$i}
    if($sel.Count -eq 0){return}
    if([Windows.Forms.MessageBox]::Show("Confirm Uninstall?","Confirm","YesNo") -eq "Yes"){
        $total=$sel.Count; $count=0
        foreach($item in $sel){ $count++; Update-UI $count $total "Removing: $item"; $d=$global:AppData[$item]
            if($d.Type -eq "Appx"){Get-AppxPackage $d.Name -AllUsers | Remove-AppxPackage}
            else { $un=$d.Uninstall; if($un -match '{[A-Z0-9-]+}'){Start-Process "msiexec.exe" -ArgumentList "/x $($matches[0]) /qn" -Wait} else { $ex=if($un.StartsWith('"')){($un -split '"')[1]}else{($un -split ' ')[0]}; Start-Process $ex -ArgumentList "/S /silent /quiet" -Wait } }
        }
        Scan-Apps; Update-UI $total $total "Finish!"; [Windows.Forms.MessageBox]::Show("Done!")
    }
})

