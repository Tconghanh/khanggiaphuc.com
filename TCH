function Add-Log ($m) { $txtLog.AppendText("[$((Get-Date).ToString('HH:mm'))] $m`n"); $txtLog.ScrollToCaret(); [System.Windows.Forms.Application]::DoEvents() }
function Update-P ($v, $t) { $progressBar.Value = [math]::Round(($v / $t) * 100); [System.Windows.Forms.Application]::DoEvents() }

function Get-SystemInfo {
    try {
        $cpu = (Get-CimInstance Win32_Processor).Name; $ram = [math]::Round((Get-CimInstance Win32_PhysicalMemory | Measure-Object Capacity -Sum).Sum / 1GB)
        $disks = Get-CimInstance Win32_LogicalDisk | Where-Object { $_.DriveType -eq 3 } | ForEach-Object {
            $total = [math]::Round($_.Size / 1GB); $free = [math]::Round($_.FreeSpace / 1GB); "$($_.DeviceID) Free:$free GB/Total:$total GB"
        }
        $lblH1.Text = "CPU: $cpu | RAM: $ram GB | DISK: $($disks -join ' | ')"
        $lan = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -notlike "*Loopback*" }).IPAddress | Select-Object -First 1
        $wan = (Invoke-RestMethod -Uri "https://api.ipify.org" -TimeoutSec 2)
        $lblH2.Text = "IP LAN: $lan | IP WAN: $wan"
    } catch { $lblH2.Text = "IP LAN: $lan | IP WAN: N/A" }
}

function Scan-Apps {
    $listUn.Items.Clear(); $global:UnTable = @{}
    $paths = @("HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*")
    foreach ($p in $paths) {
        Get-ItemProperty $p -ErrorAction SilentlyContinue | ForEach-Object {
            if ($_.DisplayName -and $_.UninstallString -and ($_.SystemComponent -ne 1) -and ($_.NoRemove -ne 1) -and ($_.ReleaseType -ne "Update")) {
                if ($_.DisplayName -notmatch "Microsoft\.NET.*Manifest" -and $_.DisplayName -notmatch "Microsoft Visual C\+\+.*Redistributable") {
                    if (!$global:UnTable.ContainsKey($_.DisplayName)) {
                        $global:UnTable[$_.DisplayName] = @{ Type="Win32"; Un=$_.UninstallString }
                        [void]$listUn.Items.Add($_.DisplayName)
                    }
                }
            }
        }
    }
    Get-ItemProperty $paths | Where-Object { $_.DisplayName -like "*Visual C++*Redistributable*" } | ForEach-Object {
        if (!$global:UnTable.ContainsKey($_.DisplayName)) {
             $global:UnTable[$_.DisplayName] = @{ Type="Win32"; Un=$_.UninstallString }; [void]$listUn.Items.Add($_.DisplayName)
        }
    }
}

