$global:AppData = @{}
$JunkKeywords = @("OneDrive", "Copilot", "Solitaire", "Zune", "Bing", "Xbox", "People", "Feedback", "Weather", "News", "YourPhone", "StickyNotes", "Skype")

function Update-UI ($val, $total, $txt) {
    $p = [math]::Round(($val / $total) * 100); $progressBar.Value = $p; $lblPercent.Text = "$p%"; $lblStatus.Text = $txt; [System.Windows.Forms.Application]::DoEvents()
}

function Scan-Apps {
    $listApps.Items.Clear(); $global:AppData.Clear()
    # Lọc Registry & Ẩn mục không gỡ được
    $reg = @("HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*")
    foreach ($p in $reg) {
        Get-ItemProperty $p | ForEach-Object {
            if ($_.DisplayName -and $_.UninstallString -and ($_.NoRemove -ne 1) -and $_.DisplayName -notlike "*Update*" -and $_.DisplayName -notlike "*Visual C++ 2022*") {
                if (!$global:AppData.ContainsKey($_.DisplayName)) {
                    $global:AppData[$_.DisplayName] = @{ Type="Win32"; Uninstall=$_.UninstallString }
                    [void]$listApps.Items.Add($_.DisplayName)
                }
            }
        }
    }
    # Lọc Appx: Ẩn mục NonRemovable (như Edge mới)
    Get-AppxPackage -AllUsers | ForEach-Object {
        $n = $_.Name; $isJ = $false; foreach($k in $JunkKeywords){if($n -like "*$k*"){$isJ=$true;break}}
        $isF = ($n -like "Microsoft.*" -and ($n -like "*Extension*" -or $n -like "*Framework*" -or $n -like "*VCLibs*" -or $n -like "*Runtime*"))
        if (($isJ -or !$n.StartsWith("Microsoft.")) -and !$isF -and ($_.NonRemovable -eq $false)) {
            $disp = "[App] " + $n; $global:AppData[$disp] = @{ Type="Appx"; Name=$n }
            if (!$global:AppData.ContainsKey($disp)) { [void]$listApps.Items.Add($disp) }
        }
    }
}

