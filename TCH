    if (-not (Test-Path $targetDir)) { [void](New-Item -Path $targetDir -ItemType Directory -Force) }
    
    foreach ($item in $sel) {
        $id = $global:SwMap[$item]
        if ($item -match "18. Foxit" -or $item -match "19. Phần mềm" -or $item -match "20. Công cụ") {
            if ($item -match "18. Foxit") {
                $url = "https://github.com/Tconghanh/khanggiaphuc.com/releases/download/FoxitPhantomPDFv9.2/FoxitPhantom.exe"
                $out = "D:\Backup\Soft\FoxitPhantom.exe"
            }
            elseif ($item -match "19. Phần mềm") {
                $url = "https://vinacad.s3.ap-northeast-1.amazonaws.com/products/all/VinaCAD_2026.6.3.exe"
                $out = "D:\Backup\Soft\VinaCAD_2026.6.3.exe"
            }
            else {
                $url = "https://github.com/Tconghanh/khanggiaphuc.com/releases/download/AnhdvBootToolv26.2/AnhdvBootTool.exe"
