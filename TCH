$btnExecApp.Add_Click({
    $sel = $listApps.CheckedItems
    if($sel.Count -eq 0){return}
    if([Windows.Forms.MessageBox]::Show("Gỡ $($sel.Count) mục?","Xác nhận","YesNo") -eq "Yes"){
        foreach($item in $sel){
            $d = $global:AppData[$item]
            if($d.Type -eq "Appx"){ Get-AppxPackage $d.Name -AllUsers | Remove-AppxPackage }
            else {
                $un = $d.Uninstall
                if($un -match '{[A-Z0-9-]+}'){ Start-Process "msiexec.exe" -ArgumentList "/x $($matches[0]) /qn" -Wait }
                else { $ex = if($un.StartsWith('"')){($un -split '"')[1]}else{($un -split ' ')[0]}; Start-Process $ex -ArgumentList "/S /silent /quiet" -Wait }
            }
        }
        Scan-Apps; [Windows.Forms.MessageBox]::Show("Xong!")
    }
})

