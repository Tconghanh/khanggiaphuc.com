# --- HÀM THỰC THI CHUỖI DOWNLOAD KHÔNG TREO UI ---
function Start-NextDownload {
    if ($global:CurrentDownloadIndex -ge $global:DownloadQueue.Count) {
        $btnCancelDl.Visible = $false
        Update-P 100 100
        if ($global:IsDownloadOnly) {
            Add-Log "Tải file offline thành công! Lưu tại D:\Backup\Soft\"
            [System.Windows.Forms.MessageBox]::Show("Tất cả bộ cài offline đã được tải về thư mục D:\Backup\Soft\", "Thông báo", "OK", "Information")
        } else {
            Add-Log "Cài đặt phần mềm hoàn tất (Software Installation Finished)"
        }
        return
    }

    $task = $global:DownloadQueue[$global:CurrentDownloadIndex]
    $item = $task.Item
    $url = $task.Url
    $out = $task.Out
    $isWinget = $task.IsWinget
    $id = $task.Id

    Add-Log "Đang xử lý (Processing): $item"
    
    if ($isWinget) {
        if ($global:IsDownloadOnly) {
            Add-Log "Đang trích xuất liên kết và tải bộ cài offline từ Winget..."
            $pos = [math]::Round((($global:CurrentDownloadIndex + 0.5) / $global:DownloadQueue.Count) * 100)
            $progressBar.Value = $pos; $lblPerc.Text = "$pos%"
            
            $sb = {
                param($id)
                $output = winget info --id $id
                $line = $output | Where-Object { $_ -match "Installer Url|Đường dẫn Trình cài đặt" }
                if ($line -and $line -match "https?://[^\s]+") {
                    return $Matches[0]
                }
                return $null
            }
            $job = Start-Job -ScriptBlock $sb -ArgumentList $id
            while ($job.State -eq "Running") { [System.Windows.Forms.Application]::DoEvents(); Start-Sleep -Milliseconds 100 }
            $resolvedUrl = Receive-Job $job
            Remove-Job $job

            if ($resolvedUrl) {
                $fileName = [System.IO.Path]::GetFileName(($resolvedUrl -split '\?')[0])
                if (-not $fileName -or $fileName -notmatch "\.(exe|msi|zip|rar)$") { $fileName = "$id`_installer.exe" }
                $wgOut = "D:\Backup\Soft\$fileName"
                
                try {
                    $wc = New-Object System.Net.WebClient
                    $wc.DownloadFile($resolvedUrl, $wgOut)
                    Add-Log "Đã tải bộ cài offline: $fileName"
                } catch {
                    Add-Log "Không thể tải trực tiếp, đang sử dụng lệnh tải hỗ trợ..."
                    Start-Process winget -ArgumentList "download --id $id --download-directory D:\Backup\Soft" -Wait -NoNewWindow
                }
            } else {
                Start-Process winget -ArgumentList "download --id $id --download-directory D:\Backup\Soft" -Wait -NoNewWindow
                Add-Log "Đã tải gói cài đặt offline thông qua Winget Download."
            }
            $global:CurrentDownloadIndex++
            Start-NextDownload
        } else {
            $scriptBlock = {
                param($id)
                Start-Process winget -ArgumentList "install --id $id --silent --accept-package-agreements --accept-source-agreements" -Wait -NoNewWindow
            }
            $pos = [math]::Round((($global:CurrentDownloadIndex + 0.5) / $global:DownloadQueue.Count) * 100)
            $progressBar.Value = $pos; $lblPerc.Text = "$pos%"
            
            $job = Start-Job -ScriptBlock $scriptBlock -ArgumentList $id
            while ($job.State -eq "Running") { [System.Windows.Forms.Application]::DoEvents(); Start-Sleep -Milliseconds 100 }
            Remove-Job $job
            
            $global:CurrentDownloadIndex++
            Start-NextDownload
        }
    } else {
        $btnCancelDl.Visible = $true
        $global:WebClient = New-Object System.Net.WebClient
        
        $onProgress = {
            param($sender, $e)
            $fileProgress = $e.ProgressPercentage
            $totalProgress = [math]::Round((($global:CurrentDownloadIndex / $global:DownloadQueue.Count) * 100) + ($fileProgress / $global:DownloadQueue.Count))
            if($totalProgress -gt 100){$totalProgress=100}
            $progressBar.Value = $totalProgress; $lblPerc.Text = "$totalProgress%"
        }
        
        $onComplete = {
            param($sender, $e)
            $global:WebClient.Dispose()
            
            if ($e.Cancelled) {
                Add-Log "Quá trình tải đã bị người dùng hủy bỏ (Download Cancelled)."
                $btnCancelDl.Visible = $false
                return
            }
            
            if ($e.Error -ne $null) {
                Add-Log "Gặp lỗi khi tải tệp tin (Failed to download): $item"
            } else {
                if ($global:IsDownloadOnly) {
                    Add-Log "Đã tải xong tệp cài đặt offline về ổ lưu trữ."
                } else {
                    Add-Log "Tải thành công. Đang khởi chạy trình cài đặt..."
                    if ($out -and (Test-Path $out)) {
                        if ($item -match "20. Công cụ") {
                            Start-Process $out -Verb RunAs -WindowStyle Normal
                            Add-Log "Đã mở giao diện tương tác cho: $item"
                        } else {
                            Start-Process $out -ArgumentList "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART" -Wait -Verb RunAs
                            Add-Log "Cài đặt thành công (Installed successfully): $item"
                        }
                    } else {
                        Add-Log "Lỗi: Không tìm thấy tệp cài đặt tại tuyến đường $out"
                    }
                }
            }
            
            $global:CurrentDownloadIndex++
            Start-NextDownload
        }

        $global:WebClient.add_DownloadProgressChanged($onProgress)
        $global:WebClient.add_DownloadFileCompleted($onComplete)
        
        try {
            $global:WebClient.DownloadFileAsync((New-Object System.Uri($url)), $out)
        } catch {
            Add-Log "Lỗi khi khởi tạo quá trình tải cho $item"
            $global:CurrentDownloadIndex++
            Start-NextDownload
        }
    }
}

function Init-DownloadQueue {
