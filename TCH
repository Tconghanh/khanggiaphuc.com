function Add-Log ($m) { $txtLog.AppendText("[$((Get-Date).ToString('HH:mm:ss'))] $m`n"); $txtLog.ScrollToCaret(); [System.Windows.Forms.Application]::DoEvents() }
function Update-P ($v, $t) { $p = [math]::Round(($v / $t) * 100); if($p -gt 100){$p=100}; $progressBar.Value = $p; $lblPerc.Text = "$p%"; [System.Windows.Forms.Application]::DoEvents() }

function Get-SystemInfo {
    try {
        $os = (Get-CimInstance Win32_OperatingSystem).Caption
        $cpu = (Get-CimInstance Win32_Processor).Name; $ram = [math]::Round((Get-CimInstance Win32_PhysicalMemory | Measure-Object Capacity -Sum).Sum / 1GB)
        $disks = Get-CimInstance Win32_LogicalDisk | Where-Object { $_.DriveType -eq 3 } | ForEach-Object {
            $total = [math]::Round($_.Size / 1GB); $free = [math]::Round($_.FreeSpace / 1GB); "$($_.DeviceID) Trống:$free GB/$total GB"
        }
        $lblH1.Text = "HĐH: $os | CPU: $cpu | RAM: $ram GB"
        $lblH2.Text = "Ổ ĐĨA: $($disks -join ' | ') | IP Mạng LAN: Đang lấy dữ liệu..."
        
        $lan = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -notlike "*Loopback*" -and $_.InterfaceAlias -notlike "*vEthernet*" }).IPAddress | Select-Object -First 1
        $lblH2.Text = "Ổ ĐĨA: $($disks -join ' | ') | IP LAN: $lan | IP WAN: " + (Invoke-RestMethod -Uri "https://api.ipify.org" -TimeoutSec 3 -ErrorAction SilentlyContinue)
    } catch { $lblH2.Text = "Không thể tải cấu hình mạng hoặc thông tin hệ thống." }
}

function Scan-Apps {
    $listUn.Items.Clear(); $global:UnTable = @{}
    $paths = @("HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*")
    foreach ($p in $paths) {
        if (Test-Path (Split-Path $p)) {
            Get-ItemProperty $p -ErrorAction SilentlyContinue | ForEach-Object {
                if ($_.DisplayName -and $_.UninstallString -and ($_.SystemComponent -ne 1) -and ($_.ReleaseType -ne "Update")) {
                    if ($_.DisplayName -notmatch "Microsoft\.NET" -and $_.DisplayName -notmatch "Visual C\+\+") {
                        if (!$global:UnTable.ContainsKey($_.DisplayName)) {
                            $global:UnTable[$_.DisplayName] = @{ Type="Win32"; Un=$_.UninstallString }
                            [void]$listUn.Items.Add($_.DisplayName)
                        }
                    }
                }
            }
        }
    }
}

