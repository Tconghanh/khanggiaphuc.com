function Add-Log ($m) { $txtLog.AppendText("[$((Get-Date).ToString('HH:mm:ss'))] $m`n"); $txtLog.ScrollToCaret(); [System.Windows.Forms.Application]::DoEvents() }
function Update-P ($v, $t) { $p = [math]::Round(($v / $t) * 100); if($p -gt 100){$p=100}; $progressBar.Value = $p; $lblPerc.Text = "$p%"; [System.Windows.Forms.Application]::DoEvents() }

function Get-SystemInfo {
    try {
        # Đọc thông tin phiên bản Windows cụ thể (Win 10 hay Win 11)
        $os = (Get-CimInstance Win32_OperatingSystem).Caption
        $cpu = (Get-CimInstance Win32_Processor).Name; $ram = [math]::Round((Get-CimInstance Win32_PhysicalMemory | Measure-Object Capacity -Sum).Sum / 1GB)
        $disks = Get-CimInstance Win32_LogicalDisk | Where-Object { $_.DriveType -eq 3 } | ForEach-Object {
            $total = [math]::Round($_.Size / 1GB); $free = [math]::Round($_.FreeSpace / 1GB); "$($_.DeviceID) Free:$free GB/$total GB"
        }
        $lblH1.Text = "OS: $os | CPU: $cpu | RAM: $ram GB"
        $lblH2.Text = "DISK: $($disks -join ' | ') | IP LAN: Fetching..."
        
        $lan = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.InterfaceAlias -notlike "*Loopback*" -and $_.InterfaceAlias -notlike "*vEthernet*" }).IPAddress | Select-Object -First 1
        $lblH2.Text = "DISK: $($disks -join ' | ') | IP LAN: $lan | IP WAN: " + (Invoke-RestMethod -Uri "https://api.ipify.org" -TimeoutSec 3 -ErrorAction SilentlyContinue)
    } catch { $lblH2.Text = "Không thể tải cấu hình mạng hoặc OS Info." }
}

function Scan-Apps {
    $listUn.Items.Clear(); $global:UnTable = @{}
    $paths = @("HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*")
    foreach ($p in $paths) {
        if (Test-Path (Split-Path $p)) {
            Get-ItemProperty $p -ErrorAction SilentlyContinue | ForEach-Object {
                if ($_.DisplayName -and $_.UninstallString -and ($_.SystemComponent -ne 1) -and ($_.ReleaseType -ne "Update")) {
                    if ($_.DisplayName -notmatch "Microsoft\.NET" -and $_.DisplayName -notmatch "Visual C\+\+") {
                        if (!$global:UnTable.ContainsKey($_.DisplayName)) {
                            $global:UnTable[$_.DisplayName] = @{ Type="Win32"; Un=$_.UninstallString }
                            [void]$listUn.Items.Add($_.DisplayName)
                        }
                    }
                }
            }
        }
    }
}

# --- TWEAKS EXECUTOR ---
$btnExTw.Add_Click({
    $sel = $listTw.CheckedItems; if($sel.Count -eq 0){return}
    $c = 0; $t = $sel.Count
    foreach($i in $sel){
        $c++; Add-Log "Processing: $i"; Update-P $c $t
        try {
            if($i -match "01. Go bo"){
                $WhiteList = @("WindowsStore", "Calculator", "Photos", "Paint", "Notepad", "StickyNotes")
                Get-AppxPackage -AllUsers | ForEach-Object {
                    $name = $_.Name; $matched = $false
                    foreach($w in $WhiteList){ if($name -like "*$w*") { $matched = $true } }
                    if(-not $matched -and $_.NonRemovable -ne $true){ Get-AppxPackage -Name $name -AllUsers | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue }
                }
            }
            if($i -match "02. Don dep"){
                $ssPath = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\StorageSense\Parameters\StoragePolicy"
                if(!(Test-Path $ssPath)){ [void](New-Item $ssPath -Force) }; Set-ItemProperty $ssPath -Name "StorageSense" -Value 1 -Type DWord -Force
                Remove-Item -Path "$env:TEMP\*" -Force -Recurse -ErrorAction SilentlyContinue 
                Remove-Item -Path "C:\Windows\Temp\*" -Force -Recurse -ErrorAction SilentlyContinue
                [void](Clear-RecycleBin -Force -Confirm:$false -ErrorAction SilentlyContinue)
                Start-Process "cleanmgr.exe" -ArgumentList "/autoclean /d C" -Wait -WindowStyle Hidden
            }
            if($i -match "03. Tat ung dung"){
                $startupPaths = @("HKLM:\Software\Microsoft\Windows\CurrentVersion\Run", "HKCU:\Software\Microsoft\Windows\CurrentVersion\Run")
                foreach($path in $startupPaths){
                    Get-ItemProperty $path -ErrorAction SilentlyContinue | Get-Member -MemberType NoteProperty | ForEach-Object {
                        $propName = $_.Name; if($propName -notmatch "EVKey" -and $propName -notmatch "UniKey"){ Remove-ItemProperty -Path $path -Name $propName -Force -ErrorAction SilentlyContinue }
                    }
                }
                Get-ChildItem "$env:APPDATA\Microsoft\Windows\Start Menu\Programs\Startup" -ErrorAction SilentlyContinue | ForEach-Object {
                    if($_.Name -notmatch "EVKey" -and $_.Name -notmatch "UniKey"){ Remove-Item $_.FullName -Force }
                }
            }
            if($i -match "04. Tat Background"){
                Set-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications" -Name "GlobalUserDisabled" -Value 1 -Type DWord -Force -ErrorAction SilentlyContinue
                Set-ItemProperty "HKLM:\SOFTWARE\Policies\Microsoft\Windows\AppPrivacy" -Name "LetAppsRunInBackground" -Value 2 -Type DWord -Force -ErrorAction SilentlyContinue
            }
            if($i -match "05. Toi uu Hieu nang"){ Start-Process "powercfg" -ArgumentList "/setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c" -Wait -WindowStyle Hidden }
            if($i -match "06. Toi uu Giao dien"){
                Set-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" -Name "VisualFXSetting" -Value 3 -Type DWord -Force
                Set-ItemProperty "HKCU:\Control Panel\Desktop" -Name "UserPreferencesMask" -Value ([byte[]](0x90,0x12,0x03,0x80,0x10,0x00,0x00,0x00)) -Force
                Set-ItemProperty "HKCU:\Control Panel\Desktop" -Name "FontSmoothing" -Value 2 -Force; Set-ItemProperty "HKCU:\Control Panel\Desktop" -Name "FontSmoothingType" -Value 2 -Force
            }
            if($i -match "07. Tat hieu ung"){ Set-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" -Name "EnableTransparency" -Value 0 -Type DWord -Force }
            if($i -match "08. Tat tinh nang Game"){
                Set-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\GameDVR" -Name "AppCaptureEnabled" -Value 0 -Type DWord -Force
                Set-ItemProperty "HKCU:\System\GameConfigStore" -Name "GameDVR_Enabled" -Value 0 -Type DWord -Force
                Set-ItemProperty "HKCU:\Software\Microsoft\GameBar" -Name "AllowAutoGameMode" -Value 0 -Type DWord -Force
            }
            if($i -match "09. Tat thong bao"){
                Set-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\Notifications\Settings" -Name "NOC_GlobalSetting" -Value 0 -Type DWord -Force
                Set-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager" -Name "SubscribedContent-338389Enabled" -Value 0 -Type DWord -Force
            }
            if($i -match "10. Tat tinh nang Cortana"){
                $cPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsCopilot"; if(!(Test-Path $cPath)){ [void](New-Item $cPath -Force) }
                Set-ItemProperty $cPath -Name "TurnOffWindowsCopilot" -Value 1 -Type DWord -Force
                Set-ItemProperty "HKCU:\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" -Name "ShowCopilotButton" -Value 0 -Type DWord -Force -ErrorAction SilentlyContinue
            }
            if($i -match "11. Tat Widget"){
                $wPath = "HKLM:\SOFTWARE\Policies\Microsoft\Dsh"; if(!(Test-Path $wPath)){ [void](New-Item $wPath -Force) }; Set-ItemProperty $wPath -Name "AllowNewsAndInterests" -Value 0 -Type DWord -Force
                Get-AppxPackage *Client.WebExperience* -AllUsers -ErrorAction SilentlyContinue | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue
            }
            if($i -match "12. Tat Search"){
                Stop-Service "WSearch" -Force -ErrorAction SilentlyContinue; Set-Service "WSearch" -StartupType Disabled -ErrorAction SilentlyContinue
                Set-Service "dosvc" -StartupType Disabled -ErrorAction SilentlyContinue
            }
            if($i -match "13. Sua loi in an"){
                Stop-Service "Spooler" -Force -ErrorAction SilentlyContinue; Remove-Item -Path "C:\Windows\System32\spool\PRINTERS\*" -Force -Recurse -ErrorAction SilentlyContinue; Start-Service "Spooler" -ErrorAction SilentlyContinue
            }
            if($i -match "14. Sua loi mang"){
                Start-Process "netsh" -ArgumentList "winsock reset" -Wait -WindowStyle Hidden
                Start-Process "netsh" -ArgumentList "int ip reset" -Wait -WindowStyle Hidden
                Start-Process "ipconfig" -ArgumentList "/flushdns" -Wait -WindowStyle Hidden
            }
            if($i -match "15. Tat cap nhat"){
                $SvcList = @("wuauserv", "bits", "waasmedicsvc")
                foreach($svc in $SvcList){ Stop-Service $svc -Force -ErrorAction SilentlyContinue; Set-Service $svc -StartupType Disabled -ErrorAction SilentlyContinue }
                Set-ItemProperty "HKLM:\SOFTWARE\Policies\Microsoft\WindowsStore" -Name "AutoDownload" -Value 2 -Type DWord -Force -ErrorAction SilentlyContinue
            }
        } catch { Add-Log "Lỗi thực thi mục: $i" }
    }
    Update-P 100 100; Add-Log "Tweaks Done."
})

