# --- LOGIC XỬ LÝ ---
$global:AppData = @{}
$JunkKeywords = @("OneDrive", "Copilot", "Solitaire", "Zune", "Bing", "Xbox", "People", "Feedback", "Weather", "News", "YourPhone", "StickyNotes")

function Scan-Apps {
    $listApps.Items.Clear(); $global:AppData.Clear()
    $paths = @("HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*")
    foreach ($p in $paths) {
        Get-ItemProperty $p | ForEach-Object {
            if ($_.DisplayName -and $_.UninstallString -and $_.DisplayName -notlike "*Update*" -and $_.DisplayName -notlike "*Graphics Driver*" -and $_.DisplayName -notlike "*Visual C++ 2022*") {
                $global:AppData[$_.DisplayName] = @{ Type="Win32"; Uninstall=$_.UninstallString }
                [void]$listApps.Items.Add($_.DisplayName)
            }
        }
    }
    Get-AppxPackage -AllUsers | ForEach-Object {
        $name = $_.Name; $isJ = $false; foreach($k in $JunkKeywords){if($name -like "*$k*"){$isJ=$true;break}}
        $isF = ($name -like "Microsoft.*" -and ($name -like "*Extension*" -or $name -like "*Framework*" -or $name -like "*VCLibs*" -or $name -like "*Runtime*"))
        if (($isJ -or !$name.StartsWith("Microsoft.")) -and !$isF -and ($_.NonRemovable -eq $false)) {
            $disp = "[App] " + $name; $global:AppData[$disp] = @{ Type="Appx"; Name=$name }
            [void]$listApps.Items.Add($disp)
        }
    }
}

# --- THỰC THI TỐI ƯU (FIXED) ---
function Run-Tweaks {
    $checked = $listTw.CheckedItems
    foreach($t in $checked) {
        Write-Host "Đang thực thi: $t" -ForegroundColor Cyan
        switch($t) {
            "Activity History - Disable" { reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\System" /v "PublishUserActivities" /t REG_DWORD /d 0 /f }
            "Telemetry - Disable" { 
                reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection" /v "AllowTelemetry" /t REG_DWORD /d 0 /f
                Set-Service DiagTrack -StartupType Disabled; Stop-Service DiagTrack
            }
            "End Task With Right Click - Enable" { reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v "TaskbarEndTask" /t REG_DWORD /d 1 /f }
            "Hibernation - Disable" { powercfg.exe /hibernate off }
            "Widgets - Remove" { reg add "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" /v "TaskbarDa" /t REG_DWORD /d 0 /f }
            "Temporary Files - Remove" {
                $temp = @("$env:TEMP\*", "C:\Windows\Temp\*", "C:\Windows\Prefetch\*", "C:\Windows\SoftwareDistribution\Download\*")
                foreach($p in $temp) { Remove-Item $p -Recurse -Force }
            }
            "Disk Cleanup - Run" {
                # PowerShell Deep Clean thay cho cleanmgr
                Dism /Online /Cleanup-Image /StartComponentCleanup /ResetBase
            }
            "Restore Point - Create" { Checkpoint-Computer -Description "Tconghanh_Tweak" -RestorePointType "MODIFY_SETTINGS" }
            "Unwanted Pre-Installed Apps - Remove" {
                foreach($j in $JunkKeywords) { Get-AppxPackage "*$j*" -AllUsers | Remove-AppxPackage }
            }
            "Location Tracking - Disable" { reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\location" /v "Value" /t REG_SZ /d "Deny" /f }
        }
    }
    [Windows.Forms.MessageBox]::Show("Tối ưu hệ thống hoàn tất!", "Thông báo")
}

