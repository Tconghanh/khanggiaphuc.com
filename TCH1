# ==============================================================================
# TCONGHANH TOOLS PROFESSIONAL - V2.1 FIXED (STABLE)
# ==============================================================================

# --- 1. THIET LAP MOI TRUONG ---
$OutputEncoding = [System.Text.Encoding]::UTF8

# Kiem tra quyen Admin
if (-NOT ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole] "Administrator")) {  
    Start-Process powershell -Verb runAs -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`""
    Exit
}

# Load cac thu vien can thiet
Add-Type -AssemblyName PresentationFramework, System.Windows.Forms, WindowsBase, System.Drawing

# --- 2. DINH NGHIA DU LIEU (Phai dat truoc khi Load UI) ---
$swMap = [ordered]@{
    "Chrome" = "Google.Chrome"; 
    "Edge" = "Microsoft.Edge"; 
    "MS Office" = "Microsoft.Office"; 
    "VLC Player" = "VideoLAN.VLC"; 
    "WinRAR" = "RARLab.WinRAR";
    "Unikey" = "PhamKimLong.UniKey"; 
    "AnyDesk" = "AnyDeskSoftwareGmbH.AnyDesk"; 
    "Visual Code" = "Microsoft.VisualStudioCode"
}

# --- 3. GIAO DIEN WPF (XAML) - DA FIX NAMESPACE ---
[xml]$xaml = @"
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tconghanh Tools Pro - Stable" Height="850" Width="1100" 
        WindowStartupLocation="CenterScreen" Background="#0F0F0F" Foreground="White">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="TCONGHANH TOOLS PROFESSIONAL" FontSize="26" FontWeight="Bold" Foreground="Cyan" HorizontalAlignment="Center"/>
            <TextBlock Name="txtSysInfo" Text="Đang tải thông tin..." Foreground="#888" HorizontalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#333" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="BACKUP &amp; DRIVERS" FontWeight="Bold" Foreground="Gold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Name="pathBackup" Text="D:\Backup_TCH" Background="#000" Foreground="Lime" Padding="8" BorderBrush="#444"/>
                    <Button Name="btnBrowse" Content="Chọn thư mục" Grid.Column="1" Margin="10,0,0,0" Padding="15,0" Background="#333" Foreground="White"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Name="btnBackupUser" Content="Backup User Data" Width="180" Height="35" Margin="0,0,10,0"/>
                    <Button Name="btnBackupDriver" Content="Backup Drivers" Width="180" Height="35"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#1A1A1A" CornerRadius="8" Margin="0,0,10,0" Padding="10" BorderBrush="#333" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="TỐI ƯU HỆ THỐNG" DockPanel.Dock="Top" Foreground="SpringGreen" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button Name="btnRunTweaks" Content="CHẠY TỐI ƯU" DockPanel.Dock="Bottom" Height="40" Background="#483D8B" Foreground="White"/>
                    <ListBox Name="listTweaks" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Foreground="White" Margin="0,3"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Background="#1A1A1A" CornerRadius="8" Margin="0,0,10,0" Padding="10" Grid.Column="1" BorderBrush="#333" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="CÀI PHẦN MỀM (WINGET)" DockPanel.Dock="Top" Foreground="DeepSkyBlue" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button Name="btnRunInstall" Content="BẮT ĐẦU CÀI" DockPanel.Dock="Bottom" Height="40" Background="#008B8B" Foreground="White"/>
                    <ListBox Name="listApps" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Foreground="White" Margin="0,3"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Background="#1A1A1A" CornerRadius="8" Padding="10" Grid.Column="2" BorderBrush="#333" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="GỠ ỨNG DỤNG" DockPanel.Dock="Top" Foreground="Orange" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Button Name="btnRunUninstall" Content="GỠ BỎ ĐÃ CHỌN" DockPanel.Dock="Bottom" Height="40" Background="#B22222" Foreground="White"/>
                    <ListBox Name="listUn" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate><CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}" Foreground="White" Margin="0,3"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,15,0,0">
            <RichTextBox Name="txtLog" Height="100" Background="#000" Foreground="Lime" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                <FlowDocument><Paragraph Name="paraLog"/></FlowDocument>
            </RichTextBox>
            <ProgressBar Name="progressMain" Height="10" Margin="0,10,0,0" Foreground="Cyan" Background="#222"/>
            <UniformGrid Columns="4" Margin="0,10,0,0" Height="40">
                <Button Name="btnMAS" Content="Active Win/Office" Background="#1B5E20" Foreground="White" Margin="0,0,5,0"/>
                <Button Name="btnTT" Content="Titus Tool" Background="#1A237E" Foreground="White" Margin="0,0,5,0"/>
                <Button Name="btnDebloat" Content="Win Debloat" Background="#4A148C" Foreground="White" Margin="0,0,5,0"/>
                <Button Name="btnExit" Content="THOÁT" Background="#333" Foreground="White"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
"@

# --- 4. KHOI TAO UI ---
try {
    $reader = (New-Object System.Xml.XmlNodeReader $xaml)
    $window = [Windows.Markup.XamlReader]::Load($reader)
} catch {
    Write-Host "Loi Load XAML: $($_.Exception.Message)" -ForegroundColor Red
    Pause
    Exit
}

# Map controls
$controls = @{}
$xaml.SelectNodes("//*[@Name]") | ForEach-Object { $controls[$_.Name] = $window.FindName($_.Name) }

# --- 5. CAC HAM HO TRO ---
function Add-Log ($msg) {
    $window.Dispatcher.Invoke({
        $run = New-Object System.Windows.Documents.Run("[$((Get-Date).ToString('HH:mm'))] $msg`r")
        $controls.paraLog.Inlines.Add($run)
        $controls.txtLog.ScrollToEnd()
    })
}

function Update-Progress ($val) {
    $window.Dispatcher.Invoke({ $controls.progressMain.Value = $val })
}

# --- 6. XU LY SU KIEN ---

# Quet ung dung
function Scan-Apps {
    Add-Log "Đang quét ứng dụng..."
    $list = New-Object System.Collections.ObjectModel.ObservableCollection[PSObject]
    $paths = @("HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*", "HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*")
    Get-ItemProperty $paths -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName } | ForEach-Object {
        $list.Add([pscustomobject]@{ DisplayName = $_.DisplayName; IsChecked = $false })
    }
    $controls.listUn.ItemsSource = $list
    Add-Log "Đã tìm thấy $($list.Count) ứng dụng."
}

# Backup Driver
$controls.btnBackupDriver.Add_Click({
    $path = Join-Path $controls.pathBackup.Text "Drivers"
    if (!(Test-Path $path)) { New-Item $path -ItemType Directory -Force }
    Add-Log "Đang Export Drivers... (Vui lòng chờ)"
    export-windowsdriver -online -destination $path | Out-Null
    Add-Log "Hoàn tất! Drivers lưu tại: $path"
})

# Backup User Data
$controls.btnBackupUser.Add_Click({
    $dest = $controls.pathBackup.Text
    $folders = @("Desktop", "MyDocuments", "MyPictures")
    foreach($f in $folders) {
        $src = [Environment]::GetFolderPath($f)
        $name = $f.Replace("My","")
        Add-Log "Đang backup $name..."
        Start-Process robocopy -ArgumentList "`"$src`" `"$dest\$name`" /E /MT:16 /R:1 /W:1 /NFL /NDL" -Wait -WindowStyle Hidden
    }
    Add-Log "Sao lưu dữ liệu xong!"
})

# Chay Tweaks
$controls.btnRunTweaks.Add_Click({
    $selected = $controls.listTweaks.ItemsSource | Where-Object { $_.IsChecked }
    foreach($t in $selected) {
        Add-Log "Thực hiện: $($t.Name)"
        if($t.Name -like "*Temp*") { 
            Remove-Item "$env:TEMP\*" -Recurse -Force -ErrorAction SilentlyContinue 
        }
        if($t.Name -like "*Update*") {
            Set-Service wuauserv -StartupType Disabled
            Stop-Service wuauserv -Force -ErrorAction SilentlyContinue
        }
        Start-Sleep -Milliseconds 300
    }
    Add-Log "Tối ưu hóa hoàn tất!"
})

# Cai dat Winget
$controls.btnRunInstall.Add_Click({
    $selected = $controls.listApps.ItemsSource | Where-Object { $_.IsChecked }
    foreach($app in $selected) {
        $id = $swMap[$app.Name]
        Add-Log "Đang cài: $id..."
        Start-Process winget -ArgumentList "install --id $id --silent --accept-package-agreements" -Wait -WindowStyle Hidden
    }
    Add-Log "Tiến trình cài đặt kết thúc."
})

# Nút Browse
$controls.btnBrowse.Add_Click({
    $dialog = New-Object System.Windows.Forms.FolderBrowserDialog
    if($dialog.ShowDialog() -eq "OK") { $controls.pathBackup.Text = $dialog.SelectedPath }
})

# Nút tiện ích
$controls.btnMAS.Add_Click({ Start-Process powershell -ArgumentList "irm https://get.activated.win | iex" })
$controls.btnTT.Add_Click({ Start-Process powershell -ArgumentList "irm https://christitus.com/win | iex" })
$controls.btnDebloat.Add_Click({ Start-Process powershell -ArgumentList "iex (irm https://debloat.raphi.re/)" })
$controls.btnExit.Add_Click({ $window.Close() })

# --- 7. NAP DU LIEU BAN DAU ---
$window.Add_Loaded({
    # Info
    $cpu = (Get-CimInstance Win32_Processor).Name
    $controls.txtSysInfo.Text = "CPU: $cpu | Windows: $((Get-ComputerInfo).OsName)"
    
    # Tweaks
    $twList = New-Object System.Collections.ObjectModel.ObservableCollection[PSObject]
    @("Dọn rác Temp", "Tắt Windows Update", "Bật Ultimate Performance", "Gỡ OneDrive") | ForEach-Object {
        $twList.Add([pscustomobject]@{ Name = $_; IsChecked = $true })
    }
    $controls.listTweaks.ItemsSource = $twList

    # Apps
    $appList = New-Object System.Collections.ObjectModel.ObservableCollection[PSObject]
    $swMap.Keys | ForEach-Object { $appList.Add([pscustomobject]@{ Name = $_; IsChecked = $false }) }
    $controls.listApps.ItemsSource = $appList

    Scan-Apps
    Add-Log "Công cụ đã sẵn sàng!"
})

# Chay Window
$window.ShowDialog() | Out-Null