$script:MountedDrive = $null
$script:WimPath = ""

# 3. NẠP ISO
$form.Add_Load({
    if (-not (Test-Path $IsoPath)) {
        $lblIsoStatus.Text = "LỖI: Không tìm thấy file 'Win11.iso' trong cùng thư mục!"
        $lblIsoStatus.ForeColor = [System.Drawing.Color]::LightCoral
        $btnInstall.Enabled = $false
        return
    }

    $lblIsoStatus.Text = "Đang phân tích file bộ cài Win11.iso, vui lòng đợi..."
    $lblIsoStatus.ForeColor = [System.Drawing.Color]::Orange
    $form.Refresh()

    try {
        $mountResult = Mount-DiskImage -ImagePath $IsoPath -StorageType ISO -PassThru -ErrorAction Stop
        $volInfo = $mountResult | Get-Volume
        $script:MountedDrive = $volInfo.DriveLetter

        $wim = Join-Path "$($script:MountedDrive):\sources" "install.wim"
        if (-not (Test-Path $wim)) { $wim = Join-Path "$($script:MountedDrive):\sources" "install.esd" }
        if (-not (Test-Path $wim)) { throw "Không tìm thấy file install.wim/esd." }

        $script:WimPath = $wim

        $images = Get-WindowsImage -ImagePath $script:WimPath
        foreach ($img in $images) { [void]$cmbEdition.Items.Add("$($img.ImageIndex). $($img.ImageName)") }
        if ($cmbEdition.Items.Count -gt 0) { $cmbEdition.SelectedIndex = 0 }

        $systemDriveLetter = $env:SystemDrive[0]
        $vols = Get-Volume | Where-Object { $_.DriveType -eq "Fixed" -and $_.FileSystem -eq "NTFS" -and $_.DriveLetter -ne $systemDriveLetter }
        
        foreach ($v in $vols) {
            $freeSpace = [math]::Round($v.SizeRemaining / 1GB, 2)
            $totalSpace = [math]::Round($v.Size / 1GB, 2)
            [void]$cmbDrive.Items.Add("$($v.DriveLetter): [$($v.FileSystemLabel)] - Trống $freeSpace GB / Tổng $totalSpace GB")
        }

        if ($cmbDrive.Items.Count -gt 0) {
            $cmbDrive.SelectedIndex = 0
            $lblIsoStatus.Text = "KẾT NỐI ISO THÀNH CÔNG! Sẵn sàng cấu hình cài đặt."
            $lblIsoStatus.ForeColor = [System.Drawing.Color]::LimeGreen
        } else {
            [void]$cmbDrive.Items.Add("Không tìm thấy phân vùng hợp lệ!")
            $btnInstall.Enabled = $false
            $lblIsoStatus.Text = "CẢNH BÁO: Hãy chia thêm 1 phân vùng trống độc lập trước!"
        }
    } catch {
        $lblIsoStatus.Text = "Lỗi nghiêm trọng khi nạp ISO: $_"
        $btnInstall.Enabled = $false
    }
})

$form.Add_FormClosing({
    if (Test-Path $IsoPath) { try { Dismount-DiskImage -ImagePath $IsoPath -ErrorAction SilentlyContinue } catch {} }
})

# 4. THỰC THI CÀI ĐẶT
$btnInstall.Add_Click({
    $selectedDriveStr = $cmbDrive.SelectedItem.ToString()
    if ($selectedDriveStr -match 'Không tìm thấy') { return }
    $targetDrive = $selectedDriveStr.Substring(0, 1)
    $imageIndex = $cmbEdition.SelectedItem.ToString().Split('.')[0].Trim()

    $msgText = "Bạn đang yêu cầu cài đặt song song Windows 11 lên phân vùng ($($targetDrive):)`r`n`r`n" +
               "Xác nhận kích hoạt tiến trình này?"
    if ([System.Windows.Forms.MessageBox]::Show($msgText, "Xác Nhận", [System.Windows.Forms.MessageBoxButtons]::YesNo, [System.Windows.Forms.MessageBoxIcon]::Warning) -eq [System.Windows.Forms.DialogResult]::Yes) {
        
        $btnInstall.Enabled = $false; $cmbDrive.Enabled = $false; $cmbEdition.Enabled = $false; 
        $chkFormat.Enabled = $false; $chkBackupDriver.Enabled = $false; $chkInstallApps.Enabled = $false
        $form.Refresh()

        # BƯỚC 1: Format
        if ($chkFormat.Checked) {
            $txtLog.AppendText("[1] Đang Format phân vùng $($targetDrive):...`r`n")
            $form.Refresh()
            try { Format-Volume -DriveLetter $targetDrive -FileSystem NTFS -NewFileSystemLabel "Windows 11 Dual" -Force -Confirm:$false -ErrorAction Stop } 
            catch { 
                [System.Windows.Forms.MessageBox]::Show("Lỗi định dạng: $_", "Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
                $btnInstall.Enabled = $true; return 
            }
        }

        # BƯỚC 2: Export Driver
        $driverBackupPath = "$($targetDrive):\DriverBackup_Temp"
        if ($chkBackupDriver.Checked) {
            $txtLog.AppendText("[2] Đang trích xuất Driver từ máy hiện tại. Chờ chút nhé...`r`n")
            $form.Refresh()
            New-Item -ItemType Directory -Force -Path $driverBackupPath | Out-Null
            Export-WindowsDriver -Online -Destination $driverBackupPath | Out-Null
            $txtLog.AppendText(" -> Hoàn tất sao lưu Driver!`r`n")
        }

        # BƯỚC 3: Bung WIM (Sử dụng tham số Compact để tăng tốc nếu là WIM, nếu ESD thì mặc định)
        $txtLog.AppendText("[3] Đang bung Windows 11 vào ổ $($targetDrive): (Vui lòng xem % ở cửa sổ đen)...`r`n")
        $form.Refresh()
        $psi = New-Object System.Diagnostics.ProcessStartInfo
        $psi.FileName = "dism.exe"
        
        # Thêm /Compact giúp quá trình bung nhanh hơn và tiết kiệm dung lượng đĩa đích
        $psi.Arguments = "/Apply-Image /ImageFile:`"$script:WimPath`" /Index:$imageIndex /ApplyDir:$($targetDrive):\ /Compact"
        
        $psi.UseShellExecute = $false
        $proc = [System.Diagnostics.Process]::Start($psi)
        $proc.WaitForExit()

        if ($proc.ExitCode -ne 0) {
            # Thử lại không có /Compact nếu gặp lỗi (một số bản WIM/ESD cũ không hỗ trợ)
            $txtLog.AppendText(" -> Lệnh Compact thất bại, đang thử lại chế độ chuẩn...`r`n")
            $form.Refresh()
            $psi.Arguments = "/Apply-Image /ImageFile:`"$script:WimPath`" /Index:$imageIndex /ApplyDir:$($targetDrive):\"
            $proc = [System.Diagnostics.Process]::Start($psi)
            $proc.WaitForExit()
            if ($proc.ExitCode -ne 0) {
                [System.Windows.Forms.MessageBox]::Show("Lỗi bung DISM!", "Lỗi", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Error)
                $btnInstall.Enabled = $true; return
            }
        }

        # BƯỚC 4: Inject Driver Offline
        if ($chkBackupDriver.Checked) {
            $txtLog.AppendText("[4] Đang cấy (Inject) Driver vừa sao lưu vào Windows 11 mới...`r`n")
            $form.Refresh()
            $psiDrv = New-Object System.Diagnostics.ProcessStartInfo
            $psiDrv.FileName = "dism.exe"
            $psiDrv.Arguments = "/Image:$($targetDrive):\ /Add-Driver /Driver:`"$driverBackupPath`" /Recurse"
            $psiDrv.UseShellExecute = $false
            $procDrv = [System.Diagnostics.Process]::Start($psiDrv)
            $procDrv.WaitForExit()
            Remove-Item -Path $driverBackupPath -Recurse -Force -ErrorAction SilentlyContinue # Xóa temp
            $txtLog.AppendText(" -> Đã tích hợp Driver thành công!`r`n")
        }

        # BƯỚC 5: Tạo Script cài phần mềm OOBE
        if ($chkInstallApps.Checked) {
            $txtLog.AppendText("[5] Đang khởi tạo bộ cài tự động phần mềm (EVKey, 7Zip, Cốc Cốc, Foxit)...`r`n")
            $form.Refresh()
            
            # Đảm bảo thư mục Desktop Public tồn tại trong Win mới
            $publicDesktop = "$($targetDrive):\Users\Public\Desktop"
            if (-not (Test-Path $publicDesktop)) { New-Item -ItemType Directory -Force -Path $publicDesktop | Out-Null }
            
            $psScriptPath = "$publicDesktop\1_CAI_PHAN_MEM_TU_DONG.ps1"
            $cmdScriptPath = "$publicDesktop\NHAN_VAO_DAY_DE_CAI_PHAN_MEM.cmd"

            $psCode = @"
Write-Host "================================================================" -ForegroundColor Cyan
Write-Host " TỰ ĐỘNG CÀI ĐẶT PHẦN MỀM - ENGINE V2.0" -ForegroundColor Yellow
Write-Host " LƯU Ý: Vui lòng kết nối Wi-Fi/Mạng trước khi để tiến trình chạy" -ForegroundColor Red
Write-Host "================================================================" -ForegroundColor Cyan
`$ProgressPreference = 'SilentlyContinue'

Write-Host "`n[1/4] Đang cài đặt Cốc Cốc Browser..." -ForegroundColor Green
winget install CocCoc.CocCocBrowser --accept-package-agreements --accept-source-agreements --silent

Write-Host "`n[2/4] Đang cài đặt 7-Zip..." -ForegroundColor Green
winget install 7zip.7zip --accept-package-agreements --accept-source-agreements --silent

Write-Host "`n[3/4] Đang cài đặt Foxit PDF (PhantomPDF / Editor)..." -ForegroundColor Green
winget install Foxit.PDFEditor --accept-package-agreements --accept-source-agreements --silent

Write-Host "`n[4/4] Đang tải EVKey..." -ForegroundColor Green
try {
    # Lấy link download bộ gõ EVKey mới nhất từ Github API
    `$release = Invoke-RestMethod -Uri "https://api.github.com/repos/lamquangminh/evkey/releases/latest"
    `$asset = `$release.assets | Where-Object { `$_.name -like "*.zip" } | Select-Object -First 1
    `$zipPath = "C:\EVKey.zip"
    `$extractPath = "C:\EVKey_BoGo"
    
    Invoke-WebRequest -Uri `$asset.browser_download_url -OutFile `$zipPath
    Expand-Archive -Path `$zipPath -DestinationPath `$extractPath -Force
    
    # Tạo shortcut ra Desktop cho người dùng
    `$WshShell = New-Object -comObject WScript.Shell
    `$Shortcut = `$WshShell.CreateShortcut("C:\Users\Public\Desktop\EVKey.lnk")
    `$Shortcut.TargetPath = "`$extractPath\EVKey64.exe"
    `$Shortcut.Save()
    Write-Host " -> Tải EVKey thành công, đã xuất icon ra Màn hình!" -ForegroundColor Green
} catch {
    Write-Host " Lỗi không tải được EVKey: `$_" -ForegroundColor Red
}

Write-Host "`n================================================================" -ForegroundColor Cyan
Write-Host " HOÀN TẤT CÀI ĐẶT! BẠN CÓ THỂ ĐÓNG CỬA SỔ NÀY BẰNG CÁCH NHẤN PHÍM BẤT KỲ." -ForegroundColor Yellow
pause
"@
            Set-Content -Path $psScriptPath -Value $psCode -Encoding UTF8

            $cmdCode = @"
@echo off
color 0a
title TRINH CAI DAT PHAN MEM TU DONG CHUYEN SAU
:: Kiem tra quyen Admin
net session >nul 2>&1
if %errorLevel% == 0 (
    echo Dang bat dau chuoi cai dat...
) else (
    echo [LOI] BAN PHAI CHAY FILE NAY VOI QUYEN ADMIN.
    echo Vui long Click chuot phai vao file nay - Chon "Run as administrator"
    pause
    exit
)
powershell -ExecutionPolicy Bypass -File "%~dp01_CAI_PHAN_MEM_TU_DONG.ps1"
"@
            Set-Content -Path $cmdScriptPath -Value $cmdCode -Encoding ASCII
        }

        # BƯỚC 6: BCDBoot
        $txtLog.AppendText("[6] Đang đăng ký vào Menu Boot song song...`r`n")
        $form.Refresh()
        $bcdProcess = Start-Process bcdboot.exe -ArgumentList "`"$($targetDrive):\Windows`"" -NoNewWindow -PassThru -Wait
        
        if ($bcdProcess.ExitCode -eq 0) {
            $txtLog.AppendText("HOÀN THÀNH HOÀN HẢO! Hệ thống Dual-Boot đã thiết lập xong.`r`n")
            [System.Windows.Forms.MessageBox]::Show("QUÁ TRÌNH CÀI ĐẶT SONG SONG ĐÃ XONG!\r\n\r\nKhởi động lại máy để thưởng thức Windows 11 mới.", "Thành Công", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Information)
        } else {
            [System.Windows.Forms.MessageBox]::Show("Lỗi tạo BCD Boot!", "Cảnh Báo", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Warning)
        }
        $btnInstall.Enabled = $true
    }
})

$form.ShowDialog() | Out-Null
