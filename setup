# =========================================================================
# SCRIPT GOI TUDONG HOA BACKUP & TAO UNATTEND.XML CO GIAO DIEN GUI CHUYEN NGHIEP
# Toi uu chay qua Cloud (khanggiaphuc.com/setup) - Khong bao gio loi font
# =========================================================================

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

# --- DOAN CODE LOGIC HE THONG ---
$BackupDir = "D:\Backup"
$InfoDir = "$BackupDir\System_Info"
$DriverDir = "$BackupDir\Drivers"
$DesktopDir = "$BackupDir\Desktop_Data"
$UnattendPath = "$BackupDir\unattend.xml"

function Initialize-BackupFolders {
    if (-not (Test-Path $BackupDir)) { New-Item -ItemType Directory -Path $BackupDir | Out-Null }
    if (-not (Test-Path $InfoDir)) { New-Item -ItemType Directory -Path $InfoDir | Out-Null }
    if (-not (Test-Path $DriverDir)) { New-Item -ItemType Directory -Path $DriverDir | Out-Null }
    if (-not (Test-Path $DesktopDir)) { New-Item -ItemType Directory -Path $DesktopDir | Out-Null }
}

function Start-KGPDeployment {
    $btnStart.Enabled = $false
    $btnStart.Text = "Dang xu ly..."
    $btnStart.BackColor = [System.Drawing.Color]::FromArgb(45, 45, 48)
    
    # Update Status
    $txtLog.AppendText("[+] Bat dau khoi tao thu muc backup tren o D...\r\n")
    Initialize-BackupFolders
    $progressBar.Value = 15
    [System.Windows.Forms.Application]::DoEvents()

    # Buoc 1: Quet IP
    $txtLog.AppendText("[+] Dang quet thong tin mang va cau hinh IP hien tai...\r\n")
    $NetAdapter = Get-NetAdapter | Where-Object {$_.Status -eq 'Up'} | Select-Object -First 1
    if ($NetAdapter) {
        $IPInfo = Get-NetIPAddress -InterfaceIndex $NetAdapter.InterfaceIndex -AddressFamily IPv4 | Where-Object {$_.IPAddress -notlike '169.254.*'} | Select-Object -First 1
        $Gateway = (Get-NetRoute -InterfaceIndex $NetAdapter.InterfaceIndex -DestinationPrefix '0.0.0.0/0').NextHop | Select-Object -First 1
        $DNSAddresses = (Get-DnsClientServerAddress -InterfaceIndex $NetAdapter.InterfaceIndex -AddressFamily IPv4).ServerAddresses
        $DNS = $DNSAddresses -join ','

        $global:CurrIP = $IPInfo.IPAddress
        $global:CurrPrefix = $IPInfo.PrefixLength
        $global:CurrGW = $Gateway
        $global:CurrDNS = $DNS

        $txtLog.AppendText("   > Phat hien IP: $global:CurrIP / Gateway: $global:CurrGW\r\n")
    } else {
        $txtLog.AppendText("   > [!] Khong lay duoc IP tu dong! Dung IP mac dinh.\r\n")
        $global:CurrIP = "192.168.100.222"
        $global:CurrPrefix = "24"
        $global:CurrGW = "192.168.100.1"
        $global:CurrDNS = "8.8.8.8,8.8.4.4"
    }
    ipconfig /all | Out-File -FilePath "$InfoDir\IP_Configuration.txt" -Encoding utf8
    $progressBar.Value = 35
    [System.Windows.Forms.Application]::DoEvents()

    # Buoc 2: Sinh file xml
    $txtLog.AppendText("[+] Dang tu dong bien dich file unattend.xml dat IP tinh...\r\n")
    $XmlContent = @"
<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend">
    <settings pass="specialize">
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <ComputerName>*</ComputerName>
        </component>
        <component name="Microsoft-Windows-TerminalServices-LocalSessionManager" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <fDenyTSConnections>false</fDenyTSConnections>
        </component>
        <component name="Microsoft-Windows-TerminalServices-RDP-To-Guest" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <UserAuthentication>1</UserAuthentication>
        </component>
    </settings>
    <settings pass="oobeSystem">
        <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <InputLocale>en-US</InputLocale>
            <SystemLocale>en-US</SystemLocale>
            <UILanguage>en-US</UILanguage>
            <UserLocale>en-US</UserLocale>
        </component>
        <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <OOBE>
                <HideEULAPage>true</HideEULAPage>
                <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
                <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
                <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
                <NetworkLocation>Work</NetworkLocation>
                <ProtectYourPC>1</ProtectYourPC>
            </OOBE>
            <UserAccounts>
                <AdministratorPassword><Value>Ht210917</Value><PlainText>true</PlainText></AdministratorPassword>
                <LocalAccounts>
                    <LocalAccount wcm:action="add">
                        <Password><Value>Ht210917</Value><PlainText>true</PlainText></Password>
                        <Description>Local Administrator Account</Description>
                        <DisplayName>Administrator</DisplayName>
                        <Group>Administrators</Group>
                        <Name>Administrator</Name>
                    </LocalAccount>
                </LocalAccounts>
            </UserAccounts>
            <AutoLogon>
                <Password><Value>Ht210917</Value><PlainText>true</PlainText></Password>
                <Enabled>true</Enabled>
                <LogonCount>1</LogonCount>
                <Username>Administrator</Username>
            </AutoLogon>
            <FirstLogonCommands>
                <SynchronousCommand wcm:action="add">
                    <Order>1</Order>
                    <CommandLine>netsh advfirewall firewall set rule group="remote desktop" new enable=Yes</CommandLine>
                    <Description>Mo Firewall RDP</Description>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <Order>2</Order>
                    <CommandLine>powershell.exe -Command "Get-NetAdapter | Where-Status Up | Set-NetIPInterface -DHCP Disabled; Get-NetAdapter | Where-Status Up | New-NetIPAddress -IPAddress '$global:CurrIP' -PrefixLength $global:CurrPrefix -DefaultGateway '$global:CurrGW'"</CommandLine>
                    <Description>Dat IP Tinh tu dong</Description>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <Order>3</Order>
                    <CommandLine>powershell.exe -Command "Get-NetAdapter | Where-Status Up | Set-DnsClientServerAddress -ServerAddresses $global:CurrDNS"</CommandLine>
                    <Description>Cau hinh DNS</Description>
                </SynchronousCommand>
                <SynchronousCommand wcm:action="add">
                    <Order>4</Order>
                    <CommandLine>powershell.exe -Command "Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private"</CommandLine>
                    <Description>Chuyen mang sang Private</Description>
                </SynchronousCommand>
            </FirstLogonCommands>
        </component>
    </settings>
</unattend>
"@
    $XmlContent | Out-File -FilePath $UnattendPath -Encoding utf8
    $txtLog.AppendText("   > Da tao xong xuat vao D:\Backup\unattend.xml\r\n")
    $progressBar.Value = 55
    [System.Windows.Forms.Application]::DoEvents()

    # Buoc 3: Export Driver
    $txtLog.AppendText("[+] Dang trich xuat Driver phan cung he thong (DISM)... Vui long cho...\r\n")
    [System.Windows.Forms.Application]::DoEvents()
    $DriverLog = Start-Process dism -ArgumentList "/online /export-driver /destination:`"$DriverDir`"" -NoNewWindow -Wait -PassThru
    if ($DriverLog.ExitCode -eq 0) {
        $txtLog.AppendText("   > [OK] Da trich xuat va phan loai Driver thanh cong.\r\n")
    } else {
        $txtLog.AppendText("   > [!] Gặp loi trong qua trinh export Driver.\r\n")
    }
    $progressBar.Value = 85
    [System.Windows.Forms.Application]::DoEvents()

    # Buoc 4: Robocopy Desktop
    $txtLog.AppendText("[+] Dang sao luu va dong bo toan bo du lieu ngoai man hinh Desktop...\r\n")
    $DesktopPath = [Environment]::GetFolderPath("Desktop")
    robocopy $DesktopPath $DesktopDir /E /COPY:DAT /R:3 /W:5 /XF desktop.ini /NDL /NFL | Out-Null
    
    # Hoan thanh
    $progressBar.Value = 100
    $txtLog.AppendText("\r\n=======================================================\r\n")
    $txtLog.AppendText(" HOAN THANH MY MAN! SAN SANG DE BUNG WIN QUA WINNTSETUP\r\n")
    $txtLog.AppendText("=======================================================\r\n")
    
    $btnStart.Text = "KHOI TẠO THANH CONG"
    $btnStart.BackColor = [System.Drawing.Color]::FromArgb(0, 122, 204)
    [System.Windows.Forms.MessageBox]::Show("Quy trinh tu dong hoa dong goi du lieu an toan thanh cong! Toan bo file cau hinh va driver nam tai D:\Backup", "Khang Gia Phuc Tech Notification", [System.Windows.Forms.MessageBoxButtons]::OK, [System.Windows.Forms.MessageBoxIcon]::Information)
}

# --- DOAN CODE DO HOA GUI MODERN (DARK MODE) ---
$form = New-Object System.Windows.Forms.Form
$form.Text = "Khang Gia Phuc Automation Engine v2.0"
$form.Size = New-Object System.Drawing.Size(650, 480)
$form.StartPosition = "CenterScreen"
$form.BackColor = [System.Drawing.Color]::FromArgb(30, 30, 30) # Dark Background
$form.FormBorderStyle = "FixedSingle"
$form.MaximizeBox = $false

# Font Base
$fontTitle = New-Object System.Drawing.Font("Segoe UI", 14, [System.Drawing.FontStyle]::Bold)
$fontLabel = New-Object System.Drawing.Font("Segoe UI", 10, [System.Drawing.FontStyle]::Regular)
$fontLog = New-Object System.Drawing.Font("Consolas", 9, [System.Drawing.FontStyle]::Regular)

# Tiêu đề Form
$lblTitle = New-Object System.Windows.Forms.Label
$lblTitle.Text = "KHANG GIA PHUC DEPLOYMENT TOOLKIT"
$lblTitle.Location = New-Object System.Drawing.Point(20, 15)
$lblTitle.Size = New-Object System.Drawing.Size(600, 30)
$lblTitle.Font = $fontTitle
$lblTitle.ForeColor = [System.Drawing.Color]::FromArgb(0, 192, 239) # Cyan Color
$form.Controls.Add($lblTitle)

# Subtitle thông tin cấu hình đích
$lblSub = New-Object System.Windows.Forms.Label
$lblSub.Text = "Backup Driver + Desktop | Auto-gen unattend.xml (User: Administrator / Pass: Ht210917)"
$lblSub.Location = New-Object System.Drawing.Point(22, 45)
$lblSub.Size = New-Object System.Drawing.Size(600, 20)
$lblSub.Font = $fontLabel
$lblSub.ForeColor = [System.Drawing.Color]::LightGray
$form.Controls.Add($lblSub)

# Khung text hiển thị tiến trình (Log Console Box)
$txtLog = New-Object System.Windows.Forms.TextBox
$txtLog.Location = New-Object System.Drawing.Point(20, 80)
$txtLog.Size = New-Object System.Drawing.Size(595, 260)
$txtLog.Multiline = $true
$txtLog.ReadOnly = $true
$txtLog.ScrollBars = "Vertical"
$txtLog.BackColor = [System.Drawing.Color]::FromArgb(15, 15, 15)
$txtLog.ForeColor = [System.Drawing.Color]::FromArgb(0, 255, 0) # Green Log Matrix
$txtLog.Font = $fontLog
$txtLog.Text = "--- San sang hanh trinh. Bam nut [KICH HOAT] de khoi dong engine ---\r\n\r\n"
$form.Controls.Add($txtLog)

# Thanh tiến trình Progress Bar
$progressBar = New-Object System.Windows.Forms.ProgressBar
$progressBar.Location = New-Object System.Drawing.Point(20, 355)
$progressBar.Size = New-Object System.Drawing.Size(595, 15)
$progressBar.Style = "Continuous"
$form.Controls.Add($progressBar)

# Nút bấm kích hoạt (Bo góc mềm giả lập)
$btnStart = New-Object System.Windows.Forms.Button
$btnStart.Location = New-Object System.Drawing.Point(20, 385)
$btnStart.Size = New-Object System.Drawing.Size(595, 40)
$btnStart.Text = "KICH HOAT ENGINE HỆ THONG"
$btnStart.Font = New-Object System.Drawing.Font("Segoe UI", 11, [System.Drawing.FontStyle]::Bold)
$btnStart.BackColor = [System.Drawing.Color]::FromArgb(0, 166, 90) # Green Accent
$btnStart.ForeColor = [System.Drawing.Color]::White
$btnStart.FlatStyle = "Flat"
$btnStart.FlatAppearance.BorderSize = 0
