"@

# 2. Đọc cấu trúc XAML vào PowerShell
$reader = (New-Object System.Xml.XmlNodeReader $xaml)
$window = [Windows.Markup.XamlReader]::Load($reader)

# 3. Kết nối các phần tử giao diện từ XAML vào biến PowerShell
$imgLogo = $window.FindName("imgLogo")
$txtUserPath = $window.FindName("txtUserPath")
$btnBrowseUser = $window.FindName("btnBrowseUser")
$btnBackupUser = $window.FindName("btnBackupUser")
$txtDriverPath = $window.FindName("txtDriverPath")
$btnBrowseDriver = $window.FindName("btnBrowseDriver")
$btnBackupDriver = $window.FindName("btnBackupDriver")
$btnUninstallApps = $window.FindName("btnUninstallApps")
$txtLog = $window.FindName("txtLog")

# 4. Tải Logo từ URL bảo đảm mượt mà không lỗi
try {
    $logoUrl = "https://khanggiaphuc.com/data/logo.jpg"
    $webClient = New-Object System.Net.WebClient
    $logoBytes = $webClient.DownloadData($logoUrl)
    $ms = New-Object System.IO.MemoryStream($logoBytes, 0, $logoBytes.Length)
    $bitmap = New-Object System.Windows.Media.Imaging.BitmapImage
    $bitmap.BeginInit()
    $bitmap.StreamSource = $ms
    $bitmap.EndInit()
    $imgLogo.Source = $bitmap
} catch {
    # Nếu không tải được logo từ URL do mất mạng, dùng ảnh mặc định chống sập script
}

# 5. Hàm ghi Nhật ký (Write Log Function)
function Add-Log ($message) {
    $timestamp = Get-Date -Format "HH:mm:ss"
    $window.Dispatcher.Invoke([Action[String]]{
        param($msg)
        $txtLog.AppendText("[$timestamp] $msg`r`n")
        $txtLog.ScrollToEnd()
    }, $message)
}

# Khởi tạo log ban đầu
Add-Log "Chào mừng đến với Tconghanh tools!"
Add-Log "Hệ thống sẵn sàng cho Windows 11."

# 6. Xử lý các sự kiện nút chọn thư mục (Browse Folder Dialog)
function Select-FolderDialog ($defaultPath) {
    $dialog = New-Object System.Windows.Forms.FolderBrowserDialog
    $dialog.Description = "Chọn thư mục lưu trữ dữ liệu"
    $dialog.SelectedPath = $defaultPath
    if ($dialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        return $dialog.SelectedPath
    }
    return $null
}

$btnBrowseUser.Add_Click({
    $path = Select-FolderDialog -defaultPath $txtUserPath.Text
    if ($path) { $txtUserPath.Text = $path }
})

$btnBrowseDriver.Add_Click({
    $path = Select-FolderDialog -defaultPath $txtDriverPath.Text
    if ($path) { $txtDriverPath.Text = $path }
})

# 7. LOGIC TÍNH NĂNG 1: BACKUP USER DATA
$btnBackupUser.Add_Click({
    $targetDir = $txtUserPath.Text.Trim()
    if (-not $targetDir.EndsWith("\")) { $targetDir += "\" }

    # Vòng lặp các thư mục cần backup
    $userFolders = @("Desktop", "Documents", "Music", "Pictures")
    $homeDir = [System.Environment]::GetFolderPath("UserProfile")

    Add-Log "=== BẮT ĐẦU SAO LƯU DỮ LIỆU USER ==="
    
    # Chạy bất đồng bộ tránh làm đơ UI giao diện
    [System.Threading.Tasks.Task]::Run({
        try {
            foreach ($folder in $userFolders) {
                $sourcePath = Join-Path $homeDir $folder
                $destinationPath = Join-Path $targetDir $folder
                
                if (Test-Path $sourcePath) {
                    Add-Log "Đang copy: $folder -> $destinationPath"
                    # Tạo thư mục đích nếu chưa có
                    if (-not (Test-Path $destinationPath)) {
                        New-Item -ItemType Directory -Force -Path $destinationPath | Out-Null
                    }
                    # Tiến hành sao lưu đè dữ liệu mới nhất bằng Robocopy (nhanh và an toàn)
                    robocopy $sourcePath $destinationPath /E /R:1 /W:1 /NDL /NFL /NJH /NJS | Out-Null
                } else {
                    Add-Log "Không tìm thấy thư mục nguồn: $folder"
                }
            }
            Add-Log ">>> HOÀN THÀNH: Sao lưu dữ liệu User thành công tại $targetDir"
            [System.Windows.MessageBox]::Show("Sao lưu dữ liệu người dùng thành công!", "Thông báo", "OK", "Information")
        } catch {
            Add-Log "LỖI trong quá trình sao lưu: $_"
        }
    })
})

# 8. LOGIC TÍNH NĂNG 2: BACKUP DRIVERS
$btnBackupDriver.Add_Click({
    $targetDir = $txtDriverPath.Text.Trim()
    Add-Log "=== BẮT ĐẦU TRÍCH XUẤT SAO LƯU DRIVER ==="
    
    [System.Threading.Tasks.Task]::Run({
        try {
            if (-not (Test-Path $targetDir)) {
                New-Item -ItemType Directory -Force -Path $targetDir | Out-Null
            }
            Add-Log "Đang phân tích và xuất Driver (Việc này có thể mất 1-2 phút)..."
            
            # Sử dụng lệnh DISM chính chủ Windows để export driver nhanh gọn
            Export-WindowsDriver -Online -Destination $targetDir -ErrorAction SilentlyContinue | Out-Null
            
            Add-Log ">>> HOÀN THÀNH: Đã sao lưu Driver hệ thống tại $targetDir"
            [System.Windows.MessageBox]::Show("Sao lưu Driver thành công!", "Thông báo", "OK", "Information")
        } catch {
            Add-Log "LỖI trong quá trình sao lưu Driver: $_"
        }
    })
})

# 9. LOGIC TÍNH NĂNG 3: TỰ ĐỘNG GỠ BỎ PHẦN MỀM RÁC (BLOATWARE)
$btnUninstallApps.Add_Click({
    $confirm = [System.Windows.MessageBox]::Show("Bạn có chắc chắn muốn tự động gỡ cài đặt các phần mềm: Copilot, OneDrive, Microsoft Games, và các phiên bản C++ cũ (Ngoại trừ C++ 2022 x64)?", "Xác nhận hành động", "YesNo", "Warning")
    
    if ($confirm -eq [System.Windows.MessageBoxResult]::Yes) {
        Add-Log "=== BẮT ĐẦU TIẾN TRÌNH DỌN DẸP / GỠ PHẦN MỀM ==="
        
        [System.Threading.Tasks.Task]::Run({
            # Gỡ bỏ Copilot / Cortana Windows 11 AppX
            Add-Log "Đang kiểm tra và gỡ bỏ Microsoft Copilot..."
            Get-AppxPackage -AllUsers *Microsoft.549981C3F5F10* | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue
            Get-AppxPackage *Cortana* | Remove-AppxPackage -ErrorAction SilentlyContinue
            Add-Log "-> Đã gỡ bỏ cấu trúc Copilot."

            # Gỡ bỏ Microsoft Games đi kèm hệ thống (Solitaire, v.v...)
            Add-Log "Đang gỡ bỏ các ứng dụng Microsoft Games..."
            Get-AppxPackage -AllUsers *MicrosoftSolitaireCollection* | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue
            Get-AppxPackage -AllUsers *XboxGamingOverlay* | Remove-AppxPackage -AllUsers -ErrorAction SilentlyContinue
            Add-Log "-> Đã gỡ các gói Game mặc định."

            # Gỡ bỏ OneDrive tận gốc
            Add-Log "Đang tiến hành gỡ bỏ Microsoft OneDrive hoàn toàn..."
            Stop-Process -Name "OneDrive" -ErrorAction SilentlyContinue
            $sys32OneDrive = "$env:SystemRoot\System32\OneDriveSetup.exe"
            $sys64OneDrive = "$env:SystemRoot\SysWOW64\OneDriveSetup.exe"
            
            if (Test-Path $sys64OneDrive) {
                Start-Process $sys64OneDrive -ArgumentList "/uninstall" -NoNewWindow -Wait -ErrorAction SilentlyContinue
            } elseif (Test-Path $sys32OneDrive) {
                Start-Process $sys32OneDrive -ArgumentList "/uninstall" -NoNewWindow -Wait -ErrorAction SilentlyContinue
            }
            Add-Log "-> Đã gửi lệnh gỡ cài đặt OneDrive."

            # Gỡ bỏ các bản Microsoft Visual C++ cũ (Giữ lại phiên bản 2022 x64)
            Add-Log "Đang phân tích danh sách Microsoft Visual C++..."
            
            # Quét Registry cho cả bản 32bit và 64bit
            $regPaths = @(
                "HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*",
                "HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*"
            )
            
            foreach ($path in $regPaths) {
                $installedApps = Get-ItemProperty $path -ErrorAction SilentlyContinue
                foreach ($app in $installedApps) {
                    if ($app.DisplayName -like "*Visual C++*") {
                        # Điều kiện loại trừ: Giữ lại bản Microsoft Visual C++ 2022 Redistributable (x64)
                        if ($app.DisplayName -like "*2022*" -and $app.DisplayName -like "*x64*") {
                            Add-Log "-> GIỮ LẠI: $($app.DisplayName)"
                        } else {
                            if ($app.UninstallString) {
                                Add-Log "Đang gỡ bỏ ngầm: $($app.DisplayName)"
                                $uninstStr = $app.UninstallString
                                
                                # Xử lý chuỗi gỡ cài đặt tự động không cần bấm (Silent mode)
                                if ($uninstStr -like "MsiExec.exe*") {
                                    $args = $uninstStr -replace "MsiExec.exe", ""
                                    $args += " /qn /norestart"
                                    Start-Process "MsiExec.exe" -ArgumentList $args -NoNewWindow -Wait -ErrorAction SilentlyContinue
                                } else {
                                    # Chạy file gỡ cài đặt trực tiếp với tham số silent nếu có
                                    if ($uninstStr -match '^"(.*?)"(.*)$') {
                                        $execPath = $matches[1]
                                        $execArgs = $matches[2] + " /uninstall /quiet /norestart"
                                    } else {
                                        $execPath = $uninstStr
                                        $execArgs = "/uninstall /quiet /norestart"
                                    }
                                    Start-Process $execPath -ArgumentList $execArgs -NoNewWindow -Wait -ErrorAction SilentlyContinue
                                }
                            }
                        }
                    }
                }
            }
            
            Add-Log ">>> HOÀN THÀNH: Tiến trình dọn dẹp hệ thống kết thúc."
            [System.Windows.MessageBox]::Show("Đã hoàn thành tiến trình dọn dẹp và tối ưu máy tính!", "Thông báo", "OK", "Information")
        })
    }
})

# 10. Chạy hiển thị giao diện phần mềm
$window.ShowDialog() | Out-Null
