# PowerShell Script: Tconghanh tools
# Hỗ trợ Windows 11 với Giao diện đồ họa WPF đẹp mắt
# Đơn vị: Công ty TNHH Khang Gia Phúc

Add-Type -AssemblyName PresentationFramework
Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

# 1. Khởi tạo mã XAML cho giao diện UI hiện đại (Dark Mode, bo góc, gọn gàng)
[xml]$xaml = @"
<Window xmlns="http://schemas.microsoft.com/winfx/2000/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2000/xaml"
        Title="Tconghanh tools - Windows 11 Utility" Height="580" Width="480" 
        WindowStartupLocation="CenterScreen" Background="#1e1e2e" ResizeMode="NoResize">
    <Grid Margin="15">
        <!-- Định nghĩa các hàng trong Grid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header & Logo -->
            <RowDefinition Height="Auto"/>   <!-- Tính năng 1: Backup User -->
            <RowDefinition Height="Auto"/>   <!-- Tính năng 2: Backup Driver -->
            <RowDefinition Height="Auto"/>   <!-- Tính năng 3: Gỡ phần mềm -->
            <RowDefinition Height="*"/>      <!-- Khung Nhật ký log -->
            <RowDefinition Height="Auto"/>   <!-- Footer / Trạng thái -->
        </Grid.RowDefinitions>

        <!-- HEADER BANNER -->
        <Border Grid.Row="0" Background="#252538" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <!-- Logo Khang Gia Phúc từ URL -->
                <Image Name="imgLogo" Width="55" Height="55" DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tconghanh tools" FontSize="20" FontWeight="Bold" Foreground="#f5e0dc"/>
                    <TextBlock Text="Giải pháp tối ưu &amp; Sao lưu Windows 11 chuyên nghiệp" FontSize="11" Foreground="#a6adc8" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- CHỨC NĂNG 1: BACKUP USER -->
        <GroupBox Grid.Row="1" Header="1. Sao lưu Dữ liệu Người dùng (User Backup)" Foreground="#cdd6f4" BorderBrush="#45475a" Margin="0,0,0,10" Padding="8">
            <StackPanel>
                <TextBlock Text="Sao lưu các thư mục: Desktop, Documents, Music, Pictures" FontSize="11" Foreground="#bac2de" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="txtUserPath" Grid.Column="0" Text="D:\Backup\" VerticalContentAlignment="Center" Height="26" Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a"/>
                    <Button Name="btnBrowseUser" Grid.Column="1" Content="..." Width="30" Margin="4,0,0,0" Height="26" Background="#45475a" Foreground="#cdd6f4"/>
                    <Button Name="btnBackupUser" Grid.Column="2" Content="Chạy Sao Lưu" Width="95" Margin="6,0,0,0" Height="26" Background="#11111b" Foreground="#a6e3a1" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- CHỨC NĂNG 2: BACKUP DRIVER -->
        <GroupBox Grid.Row="2" Header="2. Sao lưu Toàn bộ Driver Hệ thống" Foreground="#cdd6f4" BorderBrush="#45475a" Margin="0,0,0,10" Padding="8">
            <StackPanel>
                <TextBlock Text="Trích xuất tất cả driver phần cứng của bên thứ ba đang chạy trên máy" FontSize="11" Foreground="#bac2de" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="txtDriverPath" Grid.Column="0" Text="D:\Backup\Drivers" VerticalContentAlignment="Center" Height="26" Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a"/>
                    <Button Name="btnBrowseDriver" Grid.Column="1" Content="..." Width="30" Margin="4,0,0,0" Height="26" Background="#45475a" Foreground="#cdd6f4"/>
                    <Button Name="btnBackupDriver" Grid.Column="2" Content="Chạy Sao Lưu" Width="95" Margin="6,0,0,0" Height="26" Background="#11111b" Foreground="#89b4fa" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- CHỨC NĂNG 3: GỠ PHẦN MỀM TỰ ĐỘNG -->
        <GroupBox Grid.Row="3" Header="3. Gỡ tự động ứng dụng rác (Bloatware &amp; Thừa)" Foreground="#cdd6f4" BorderBrush="#45475a" Margin="0,0,0,10" Padding="8">
            <StackPanel>
                <TextBlock Text="Tự động dọn dẹp: Copilot, OneDrive, Microsoft Games, C++ cũ (Giữ lại C++ 2022 x64)" FontSize="10.5" Foreground="#f38ba8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Button Name="btnUninstallApps" Content="Bắt Đầu Gỡ Bỏ Tự Động" Height="30" Background="#11111b" Foreground="#f38ba8" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>

        <!-- KHUNG NHẬT KÝ LOG PROCESS -->
        <TextBox Name="txtLog" Grid.Row="4" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#11111b" Foreground="#a6e3a1" FontFamily="Consolas" FontSize="11" Padding="5" BorderBrush="#313244"/>

        <!-- FOOTER / BẢO QUYỀN -->
        <TextBlock Grid.Row="5" Text="© 2026 Khang Gia Phúc IT Services | Trần Công Hạnh Tools" FontSize="10" Foreground="#585b70" HorizontalAlignment="Center" Margin="0,8,0,0"/>
